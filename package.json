{
  "name": "midnight-ballot",
  "version": "0.1.0",
  "private": true,
  "description": "Private, eligibility-gated voting with publicly verifiable tallies on Midnight Network.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/contracts",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "compile:contracts": "npm run compile -w packages/contracts",
    "build": "npm run compile:contracts && npm run build -w packages/shared && npm run build -w packages/server && npm run build -w packages/client",
    "dev:server": "npm run dev -w packages/server",
    "dev:client": "npm run dev -w packages/client",
    "lint": "npm run lint -w packages/shared -w packages/server -w packages/client",
    "typecheck": "npm run typecheck -w packages/shared -w packages/contracts -w packages/server -w packages/client",
    "test": "npm run test -w packages/contracts -w packages/server",
    "test:contracts": "npm run test -w packages/contracts",
    "test:server": "npm run test -w packages/server",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "deploy:contract": "tsx scripts/deploy-contract.ts",
    "create:poll": "tsx scripts/create-poll.ts",
    "register:voter": "tsx scripts/register-voter.ts",
    "read:tally": "tsx scripts/read-tally.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
