# Copied to .env by scripts/bootstrap.sh — fill in real values before running services.
# NEVER commit .env. See docs/DEPLOYMENT.md for the full variable reference.

# --- Compact compiler (see docs/DECISIONS.md) -----------------------------
COMPACTC_VERSION=0.31.1

# --- Network -----------------------------------------------------------
# One of: undeployed | preview | preprod | mainnet
NETWORK_ID=undeployed
NODE_URL=http://localhost:9944
INDEXER_URL=http://localhost:8088/api/v4/graphql
INDEXER_WS_URL=ws://localhost:8088/api/v4/graphql/ws
PROOF_SERVER_URL=http://localhost:6300

# --- Server --------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATA_DIR=./data
ZK_CONFIG_URL=http://localhost:5173/zk

# --- DUST sponsorship (optional; server never sees voter secrets) --------
SPONSOR_ENABLED=false
# Space-separated BIP39 seed words for the sponsor wallet. Local/dev only —
# in production this must come from a secrets manager, never a plain .env.
SPONSOR_WALLET_SEED=
SPONSOR_RATE_LIMIT_PER_MINUTE=10

# --- Client (Vite, must be prefixed VITE_) --------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_NETWORK_ID=undeployed
VITE_ZK_CONFIG_URL=/zk
